{
  "name": "weather-app",
  "version": "2.0.0",
  "description": "Minimalist weather website with live data, forecast, air quality, and geolocation. Swiss-inspired design. Built with TypeScript and Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT",
  "author": "Mateusz Szostak",
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
